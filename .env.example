# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=5173
PUBLIC_BASE_URL=http://127.0.0.1:5173
RUNTIME_MODE=embedded
DATA_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Persistent runtime (Docker / production)
DATABASE_URL=postgres://dancemirror:dancemirror@postgres:5432/dancemirror
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=2

# Media processing
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/media
WORK_DIR=./data/work
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_BYTES=524288000
MAX_VIDEO_DURATION_SEC=180
MEDIA_URL_TTL_SEC=900

# Alibaba Cloud OSS (required when STORAGE_DRIVER=oss)
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_INTERNAL=false

# DeepSeek OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_RETRIES=1

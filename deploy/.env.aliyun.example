APP_DOMAIN=beta.example.com
APP_NODE_ENV=production
APP_PORT=5173
POSTGRES_PASSWORD=replace-with-a-strong-database-password
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
WORKER_CONCURRENCY=2
CLEANUP_INTERVAL_MINUTES=60

OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=replace-with-private-bucket-name
OSS_ACCESS_KEY_ID=replace-with-ram-user-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-user-access-key-secret

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
